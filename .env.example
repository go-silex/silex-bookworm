# Mot de passe unique qui protège ta bibliothèque en ligne.
# Choisis-en un long, il ne se retient pas : tu le taperas une fois par appareil.
LIBRARY_PASSWORD=

# Facultatif — active la reconnaissance de couverture par photo.
# Clé gratuite à créer sur https://aistudio.google.com/apikey
# Sans elle, tout le reste fonctionne ; seul le scan est désactivé.
GEMINI_API_KEY=

# Facultatif — pour changer de modèle sans toucher au code.
# GEMINI_MODEL=gemini-2.5-flash

# Injecté automatiquement par Vercel quand tu connectes un store Blob au projet.
# Ne le remplis pas à la main.
# BLOB_READ_WRITE_TOKEN=
